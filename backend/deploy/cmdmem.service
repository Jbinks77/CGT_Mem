[Unit]
Description=cmdmem — Smart Command Memory API
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
Environment="PATH=__VENV_DIR__/bin"
EnvironmentFile=__APP_DIR__/.env
ExecStart=__VENV_DIR__/bin/uvicorn app.main:app --host 127.0.0.1 --port __PORT__ --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cmdmem

# Sécurité
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/cmdmem/data

[Install]
WantedBy=multi-user.target
