{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "chagnat.fr" }],
      "destination": "https://www.chagnat.fr",
      "permanent": true
    }
  ]
}
